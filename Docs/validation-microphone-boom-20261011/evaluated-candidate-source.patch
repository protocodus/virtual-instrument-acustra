diff --git a/Source/DSP/MicrophoneBalanceData.h b/Source/DSP/MicrophoneBalanceData.h
index 1811e67..c1d5966 100644
--- a/Source/DSP/MicrophoneBalanceData.h
+++ b/Source/DSP/MicrophoneBalanceData.h
@@ -18,8 +18,15 @@ inline constexpr float originalCaptureLevelAdjustmentDb = 1.2172f;
 inline constexpr float originalBassShelfAdjustmentDb = -3.0f;
 inline constexpr float originalAirPeakAdjustmentDb = -2.75f;
 
+// Listener-reported low-body boom: Parlor B1, Auditorium A1 and Jumbo
+// E1-F1 in Reason's octave names. Follow each construction's actual A0,
+// including its wood morph, rather than suppressing a fixed played note.
+// This is an authored microphone contour, not extra mechanical damping.
+inline constexpr float microphoneAirCutDb = -6.0f;
+inline constexpr float microphoneAirCutQ = 5.0f;
+
 constexpr CaptureVoicingSection balancedOriginalCaptureSection(
-    CaptureVoicingSection section) noexcept
+    CaptureVoicingSection section, float airFrequencyHz = 0.0f) noexcept
 {
     // The fitted bass shelf and 125 Hz boost reinforce the close microphone's
     // already dominant bass fundamental, especially on Auditorium A2.
@@ -27,7 +34,17 @@ constexpr CaptureVoicingSection balancedOriginalCaptureSection(
     if (section.kind == CaptureVoicingKind::LowShelf && section.frequencyHz == 120.0f)
         section.gainDb += originalBassShelfAdjustmentDb;
     else if (section.kind == CaptureVoicingKind::Peak && section.frequencyHz == 125.0f)
+    {
         section.gainDb += originalAirPeakAdjustmentDb;
+        // Reuse the previously neutral section: no additional runtime stage.
+        // Zero retains the accepted Dreadnought response exactly.
+        if (airFrequencyHz > 0.0f)
+        {
+            section.frequencyHz = airFrequencyHz;
+            section.gainDb = microphoneAirCutDb;
+            section.q = microphoneAirCutQ;
+        }
+    }
