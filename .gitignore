*~

# Audio is generated locally and is not stored in this repository. The
# preset demos are the exception: they are tracked, and the main build adds
# them with -f, so the technique renders beside them in Docs/audio stay out.
*.[wW][aA][vV]

# Coefficients fitted from Mark Rau's guitar measurements, which carry no
# redistribution license: Tools/GenerateRauGuitarCandidates.py writes them
# locally and they are never committed.
/Source/DSP/RauQualifiedGuitarData.h
/Docs/rau-guitar-candidate-report.json

# Generated versioned distributions and Python script caches.
/dist/
__pycache__/
